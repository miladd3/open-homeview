    "events": {
      "description": "Things in Home Assistant that open an app on their own, e.g. a ring opens the camera.",
      "anyOf": [
        {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "entity": {
                "type": "string",
                "pattern": "^[a-z_]+\\.[a-z0-9_]+$",
                "x-entity-domain": "*",
                "description": "What to watch. An event.* entity (like a doorbell ring) fires every time it changes; any other entity needs `to`."
              },
              "open": {
                "type": "string",
                "minLength": 1,
                "description": "ID of the app to open, e.g. a camera app."
              },
              "to": {
                "description": "Fires when the entity's state changes to this, e.g. 'on'. Not for event.* entities.",
                "anyOf": [
                  {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 1
                      },
                      {
                        "type": "number"
                      }
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "eventTypes": {
                "description": "For event.* entities: only these event types fire (e.g. [ring]). Leave out for all.",
                "anyOf": [
                  {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "message": {
                "description": "Shown on the camera view, e.g. \"Someone is at the door\".",
