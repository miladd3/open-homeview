{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "wallpaper": {
      "default": [
        "#2a2f6b",
        "#7a3d5c"
      ],
      "description": "Background colors.",
      "type": "array",
      "prefixItems": [
        {
          "type": "string",
          "minLength": 1,
          "description": "Any CSS color, e.g. \"#ff9f0a\"."
        },
        {
          "type": "string",
          "minLength": 1,
          "description": "Any CSS color, e.g. \"#ff9f0a\"."
        }
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "graphics": {
      "default": "full",
      "description": "lite: no live blur or shadows, for weak GPUs like a Raspberry Pi.",
      "type": "string",
      "enum": [
        "full",
        "lite"
      ]
    },
    "weather": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^weather\\.[a-z0-9_]+$",
          "x-entity-domain": "weather",
          "description": "A weather.* entity ID from Home Assistant."
        },
        {
          "type": "null"
        }
      ]
    },
    "rooms": {
      "description": "Room tiles on the Home screen.",
      "anyOf": [
        {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "description": "Unique ID, e.g. living-room."
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "icon": {
                "default": "house",
                "description": "Icon name (Lucide). The full list is in src/config/icons.ts.",
                "type": "string",
                "enum": [
                  "armchair",
                  "baby",
                  "bath",
                  "bed",
                  "bed-single",
                  "bell",
                  "book",
                  "bot",
                  "briefcase",
                  "car",
                  "cctv",
                  "coffee",
                  "cooking-pot",
                  "door",
                  "dumbbell",
                  "fan",
                  "flower",
                  "gamepad",
                  "house",
                  "lamp",
                  "lamp-desk",
                  "laptop",
                  "lightbulb",
                  "monitor",
                  "music",
                  "plug",
                  "shield",
                  "shield-check",
                  "shower",
                  "sofa",
                  "speaker",
                  "thermometer",
                  "trees",
                  "tv",
                  "utensils",
                  "washing-machine"
                ]
              },
              "lights": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^light\\.[a-z0-9_]+$",
                  "x-entity-domain": "light",
                  "description": "A light.* entity ID from Home Assistant."
                },
                "description": "The lights this room tile switches. A whole-room group light works best."
              },
              "scenes": {
                "anyOf": [
                  {
                    "type": "array",
                    "items": {
                      "anyOf": [
                        {
                          "type": "string",
                          "pattern": "^scene\\.[a-z0-9_]+$",
                          "x-entity-domain": "scene",
                          "description": "A scene. Shorthand for { entity: scene.x }."
                        },
                        {
                          "type": "object",
                          "properties": {
                            "entity": {
                              "type": "string",
                              "pattern": "^scene\\.[a-z0-9_]+$",
                              "x-entity-domain": "scene",
                              "description": "A scene.* entity ID from Home Assistant."
                            },
                            "name": {
                              "description": "Defaults to the scene's name in Home Assistant.",
                              "anyOf": [
                                {
                                  "type": "string",
                                  "minLength": 1
                                },
                                {
                                  "type": "null"
                                }
                              ]
                            },
                            "colors": {
                              "default": [
                                "#ffd27a",
                                "#ff9f0a"
                              ],
                              "description": "Two colors for a gradient: [from, to].",
                              "type": "array",
                              "prefixItems": [
                                {
                                  "type": "string",
                                  "minLength": 1,
                                  "description": "Any CSS color, e.g. \"#ff9f0a\"."
                                },
                                {
                                  "type": "string",
                                  "minLength": 1,
                                  "description": "Any CSS color, e.g. \"#ff9f0a\"."
                                }
                              ],
                              "items": false,
                              "minItems": 2,
                              "maxItems": 2
                            }
                          },
                          "required": [
                            "entity"
                          ],
                          "additionalProperties": false
                        }
                      ]
                    }
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "id",
              "name",
              "lights"
            ],
            "additionalProperties": false
          }
        },
        {
          "type": "null"
        }
