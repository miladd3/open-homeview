{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["eslint", "typescript", "unicorn", "oxc", "vue", "vitest"],
  "env": {
    "browser": true
  },
  "categories": {
    "correctness": "error"
  },
  "overrides": [
    {
      "files": ["src/apps/*/**", "src/faces/*/**", "src/themes/*/**"],
      "excludeFiles": ["**/__tests__/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["*", "!vue", "!@lucide/vue", "!@/kit", "!@/kit/define", "!./*", "!."],
                "message": "App, face and theme folders import only from @/kit, @/kit/define, vue, @lucide/vue and their own folder."
              }
            ]
          }
        ]
      }
    }
  ]
}
