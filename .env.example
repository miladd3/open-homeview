# Home Assistant connection (server side only, never sent to the browser).
#
# Docker:     copy to `.env` next to compose.yaml.
# Local dev:  copy to `.env.local`; `npm run dev` then talks to your real HA
#             instead of the built-in mock.
#
# Create the token in HA under a dedicated non-admin user (e.g. "kiosk"):
# Profile → Security → Long-lived access tokens.
HA_URL=http://homeassistant.local:8123
HA_TOKEN=
# Suggest your entity IDs in the editor schema (readable by anyone on your network).
# SCHEMA_ENTITIES=true
